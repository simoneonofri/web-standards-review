{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/simoneonofri/w3c-webappsec-miner/schemas/security-controls.schema.json",
  "title": "WebAppSec security controls catalog",
  "type": "object",
  "required": ["schema_version", "charter_url", "controls"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "charter_url": {"const": "https://w3c.github.io/charter-drafts/2026/charter-wg-webappsec-2026.html"},
    "controls": {
      "type": "array",
      "items": {"$ref": "#/$defs/control"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["source_title", "source_url", "section", "evidence_class", "evidence_status"],
      "properties": {
        "source_title": {"type": "string", "minLength": 1},
        "source_url": {"type": "string", "pattern": "^https://"},
        "section": {"type": "string", "minLength": 1},
        "evidence_class": {"enum": ["explicit-normative", "explicit-informative", "derived-cross-spec-synthesis", "charter-scope"]},
        "evidence_status": {"enum": ["verified-official-w3c-tr", "verified-official-whatwg", "verified-official-editor-draft", "verified-local-source-packet-v1", "inventory-only"]},
        "source_packet_evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "control": {
      "type": "object",
      "required": ["control_id", "title", "family", "mechanism", "review_question", "applicability", "normative_strength", "default_ids", "exception_ids", "evidence", "limitations"],
      "properties": {
        "control_id": {"type": "string", "pattern": "^WAM-[A-Z]+-[0-9]{2}$"},
        "title": {"type": "string", "minLength": 1},
        "family": {"type": "string", "minLength": 1},
        "mechanism": {"type": "string", "minLength": 1},
        "review_question": {"type": "string", "minLength": 1},
        "applicability": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "normative_strength": {"enum": ["MUST", "SHOULD", "MAY", "algorithm-required", "framework-defined", "informative-recommendation", "synthesis"]},
        "default_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^WAD-[0-9]{2}$"}},
        "exception_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^WAE-[0-9]{2}$"}},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
        "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    }
  }
}

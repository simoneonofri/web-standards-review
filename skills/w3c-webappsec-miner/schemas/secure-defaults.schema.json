{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/simoneonofri/w3c-webappsec-miner/schemas/secure-defaults.schema.json",
  "title": "WebAppSec secure defaults catalog",
  "type": "object",
  "required": ["schema_version", "defaults"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "defaults": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["default_id", "title", "behavior", "applicability", "explicitness", "normative_strength", "control_ids", "exception_ids", "evidence", "limitations"],
        "properties": {
          "default_id": {"type": "string", "pattern": "^WAD-[0-9]{2}$"},
          "title": {"type": "string", "minLength": 1},
          "behavior": {"type": "string", "minLength": 1},
          "applicability": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "explicitness": {"enum": ["explicit-platform-default", "explicit-algorithmic-default", "recommended-synthesis"]},
          "normative_strength": {"enum": ["MUST", "SHOULD", "algorithm-required", "framework-defined", "informative-recommendation", "synthesis"]},
          "control_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^WAM-[A-Z]+-[0-9]{2}$"}, "uniqueItems": true},
          "exception_ids": {"type": "array", "items": {"type": "string", "pattern": "^WAE-[0-9]{2}$"}, "uniqueItems": true},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "object"}},
          "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

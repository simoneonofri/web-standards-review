{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/simoneonofri/w3c-webappsec-miner/schemas/exceptions.schema.json",
  "title": "WebAppSec exceptions catalog",
  "type": "object",
  "required": ["schema_version", "exceptions"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["exception_id", "title", "condition", "effect", "security_consequence", "normative_strength", "control_ids", "evidence", "limitations"],
        "properties": {
          "exception_id": {"type": "string", "pattern": "^WAE-[0-9]{2}$"},
          "title": {"type": "string", "minLength": 1},
          "condition": {"type": "string", "minLength": 1},
          "effect": {"type": "string", "minLength": 1},
          "security_consequence": {"type": "string", "minLength": 1},
          "normative_strength": {"enum": ["MUST", "SHOULD", "MAY", "algorithm-required", "framework-defined", "informative-recommendation"]},
          "control_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^WAM-[A-Z]+-[0-9]{2}$"}, "uniqueItems": true},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "object"}},
          "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

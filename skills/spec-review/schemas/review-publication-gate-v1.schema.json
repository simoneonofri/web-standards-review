{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/simoneonofri/spec-security-review/schemas/review-publication-gate-v1.schema.json",
  "title": "Review Publication Gate Contract v1",
  "type": "object",
  "required": [
    "schema_version",
    "artifact",
    "status",
    "checks",
    "inputs",
    "human_approval"
  ],
  "properties": {
    "schema_version": {
      "const": "review-publication-gate/v1"
    },
    "artifact": {
      "type": "object",
      "required": ["reference", "sha256"],
      "properties": {
        "reference": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": true
    },
    "status": {
      "type": "string",
      "enum": ["pass", "fail"]
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["check_id", "status", "evidence", "errors"],
        "properties": {
          "check_id": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["pass", "fail", "not_supplied"]},
          "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "errors": {"type": "array", "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": true
      }
    },
    "inputs": {
      "type": "object",
      "required": ["fact_check_result"],
      "properties": {
        "fact_check_result": {"type": "string", "minLength": 1},
        "analysis_gate": {"type": ["string", "null"]},
        "independent_review_gate": {"type": ["string", "null"]},
        "publication_boundary_audit": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "human_approval": {
      "type": "object",
      "required": ["required", "status"],
      "properties": {
        "required": {"const": true},
        "status": {"type": "string", "enum": ["not_recorded", "approved", "rejected"]},
        "approver": {"type": ["string", "null"]},
        "approved_at": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}

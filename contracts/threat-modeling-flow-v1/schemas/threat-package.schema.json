{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/threat-model-contract-v1/threat-package.schema.json",
  "title": "Threat Package v1",
  "type": "object",
  "required": [
    "contract_version",
    "threat_package_id",
    "model_id",
    "source_contract_version",
    "threats",
    "coverage_notes",
    "blocked_elements",
    "unresolved_model_gaps",
    "skeptic_result"
  ],
  "properties": {
    "contract_version": {"const": 1},
    "threat_package_id": {"type": "string", "minLength": 1},
    "model_id": {"type": "string", "minLength": 1},
    "source_contract_version": {"const": 1},
    "threats": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "threat_id",
          "affected_model_elements",
          "actor_or_condition",
          "action_or_failure",
          "violated_property_or_interest",
          "consequence",
          "threat_story",
          "evidence_status",
          "evidence",
          "assumptions",
          "lens",
          "harm",
          "response_hint",
          "responsibility_or_transfer_hint",
          "remaining_question"
        ],
        "properties": {
          "threat_id": {"type": "string", "pattern": "^T-[0-9]{2,}$"},
          "affected_model_elements": {"type": "array", "items": {"type": "string", "pattern": "^(EE|PO|DS|DF|TB)-[0-9]{2,}$"}, "minItems": 1},
          "actor_or_condition": {"type": "string", "minLength": 1},
          "action_or_failure": {"type": "string", "minLength": 1},
          "violated_property_or_interest": {"type": "string", "minLength": 1},
          "consequence": {"type": "string", "minLength": 1},
          "threat_story": {"type": "string", "minLength": 1},
          "evidence_status": {"enum": ["supplied", "verified", "inferred", "assumed", "untested", "unavailable"]},
          "evidence": {"type": "array", "minItems": 1},
          "assumptions": {"type": "array"},
          "lens": {"type": "array", "items": {"type": "string"}},
          "concern_area": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["security", "privacy", "unclear"]}
          },
          "threat_analysis_framework": {"type": "array", "items": {"type": "string"}},
          "threat_category": {"type": "array", "items": {"type": "string"}},
          "finding_mode": {"type": "string"},
          "weakness": {"type": "string"},
          "harm": {"type": "string"},
          "response_hint": {"type": "string"},
          "responsibility_or_transfer_hint": {"type": "string"},
          "remaining_question": {"type": "string"},
          "prompt_seed": {"type": "string"},
          "found_by_methods": {
            "type": "array",
            "items": {"enum": ["as_is_threat_model", "stride_per_element", "linddun_per_element", "rfc3552_security_per_element", "rfc6973_privacy_per_element", "rfc9620_human_rights_per_element", "browser_fingerprinting_prompt_lens", "xs_leaks_oracle_checklist", "microsoft_harms_modeling_per_element", "workshop_simulation", "stride_workshop_simulation", "linddun_workshop_simulation", "checklist_assessment", "principles_assessment", "design_principles_assessment", "privacy_principles_assessment", "independent_additional_elicitation"]}
          },
          "method_provenance": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["method"],
              "properties": {
                "method": {"enum": ["as_is_threat_model", "stride_per_element", "linddun_per_element", "rfc3552_security_per_element", "rfc6973_privacy_per_element", "rfc9620_human_rights_per_element", "browser_fingerprinting_prompt_lens", "xs_leaks_oracle_checklist", "microsoft_harms_modeling_per_element", "workshop_simulation", "stride_workshop_simulation", "linddun_workshop_simulation", "checklist_assessment", "principles_assessment", "design_principles_assessment", "privacy_principles_assessment", "independent_additional_elicitation"]},
                "trace_ids": {"type": "array", "items": {"type": "string"}},
                "question_ids": {"type": "array", "items": {"type": "string"}},
                "card_play_ids": {"type": "array", "items": {"type": "string"}},
                "checklist_check_ids": {"type": "array", "items": {"type": "string"}},
                "notes": {"type": "string"}
              }
            }
          },
          "coverage_relation": {
            "enum": ["new_uncovered_threat", "new_partially_covered_threat", "already_explicitly_documented", "already_implicitly_signaled", "silently_responded", "method_confirmed_existing", "method_refined_existing", "not_applicable_prompt"]
          },
          "related_as_is_threat_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "elicitation_trace": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "trace_id",
          "model_element_id",
          "model_element_type",
          "model_element_name",
          "evidence_status",
          "selected_lenses",
          "questions"
        ],
        "properties": {
          "trace_id": {"type": "string", "minLength": 1},
          "model_element_id": {"type": "string", "minLength": 1},
          "model_element_type": {"type": "string", "minLength": 1},
          "model_element_name": {"type": "string", "minLength": 1},
          "evidence_status": {"enum": ["supplied", "verified", "inferred", "assumed", "untested", "unavailable"]},
          "selected_lenses": {"type": "array", "items": {"type": "string"}},
          "questions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "question_id",
                "lens",
                "question",
                "answer",
                "answer_status",
                "derived_threat_ids"
              ],
              "properties": {
                "question_id": {"type": "string", "minLength": 1},
                "lens": {"type": "string", "minLength": 1},
                "source_card_id": {"type": "string"},
                "source_checklist_item_id": {"type": "string"},
                "question": {"type": "string", "minLength": 1},
                "answer": {"type": "string", "minLength": 1},
                "answer_status": {
                  "enum": ["generated_threat", "no_applicable_threat", "model_gap", "blocked", "deferred"]
                },
                "derived_threat_ids": {"type": "array", "items": {"type": "string"}},
                "assumptions": {"type": "array"},
                "notes": {"type": "string"}
              }
            }
          },
          "element_summary": {"type": "string"},
          "unanswered_questions": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "as_is_threat_model": {
      "type": "object",
      "required": ["mode", "source_materials", "source_signals", "summary"],
      "properties": {
        "mode": {"const": "as_is_threat_model"},
        "aliases": {"type": "array", "items": {"type": "string"}},
        "source_materials": {"type": "array"},
        "source_signals": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "signal_id",
              "signal_type",
              "concern_area",
              "affected_model_elements",
              "source_reference",
              "implied_concern",
              "evidence_status",
              "confidence",
              "derived_threat_ids"
            ],
            "properties": {
              "signal_id": {"type": "string", "minLength": 1},
              "signal_type": {"type": "string", "minLength": 1},
              "concern_area": {"enum": ["security", "privacy", "both", "unclear"]},
              "affected_model_elements": {"type": "array", "items": {"type": "string"}},
              "source_reference": {"type": "string", "minLength": 1},
              "source_quote": {"type": "string"},
              "implied_concern": {"type": "string", "minLength": 1},
              "existing_response_or_delegation": {"type": "string"},
              "evidence_status": {"enum": ["supplied", "verified", "inferred", "assumed", "untested", "unavailable"]},
              "confidence": {"enum": ["low", "medium", "high"]},
              "derived_threat_ids": {"type": "array", "items": {"type": "string"}},
              "notes": {"type": "string"}
            }
          }
        },
        "summary": {"type": "object"}
      }
    },
    "remediation_handoff": {
      "type": "object",
      "required": ["mode", "target_skill", "rows", "summary"],
      "properties": {
        "mode": {"const": "as_is_remediation_handoff"},
        "target_skill": {"const": "what-are-we-going-to-do-about-it"},
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "remediation_id",
              "threat_id",
              "affected_model_elements",
              "source_signal_ids",
              "current_response_or_gap",
              "response_kind",
              "suggested_erta",
              "evidence_status",
              "evidence",
              "assumptions",
              "remaining_threat",
              "next_action"
            ],
            "properties": {
              "remediation_id": {"type": "string", "minLength": 1},
              "threat_id": {"type": "string", "minLength": 1},
              "affected_model_elements": {"type": "array", "items": {"type": "string"}},
              "source_signal_ids": {"type": "array", "items": {"type": "string"}},
              "current_response_or_gap": {"type": "string", "minLength": 1},
              "response_kind": {"enum": ["existing_mitigation", "partial_mitigation", "delegated_responsibility", "accepted_or_non_goal", "no_response_found", "needs_clarification"]},
              "suggested_erta": {"enum": ["Eliminate", "Reduce", "Transfer", "Accept", "Unclear"]},
              "owner_or_receiver": {"type": "string"},
              "evidence_status": {"enum": ["supplied", "verified", "inferred", "assumed", "untested", "unavailable"]},
              "evidence": {"type": "array"},
              "assumptions": {"type": "array"},
              "remaining_threat": {"type": "string"},
              "next_action": {"type": "string"},
              "notes": {"type": "string"}
            }
          }
        },
        "summary": {"type": "object"}
      }
    },
    "checklist_assessment": {
      "type": "object",
      "required": ["mode", "checklist_source", "checklist_items", "element_checks"],
      "properties": {
        "mode": {"const": "checklist_assessment"},
        "checklist_source": {
          "type": "object",
          "required": ["source_id", "source_reference", "selected_families"],
          "properties": {
            "source_id": {"type": "string", "minLength": 1},
            "source_reference": {"type": "string", "minLength": 1},
            "selected_families": {"type": "array", "items": {"type": "string"}}
          }
        },
        "checklist_items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["checklist_item_id", "family", "prompt", "applies_to", "source_kind"],
            "properties": {
              "checklist_item_id": {"type": "string", "minLength": 1},
              "family": {"type": "string", "minLength": 1},
              "prompt": {"type": "string", "minLength": 1},
              "applies_to": {"type": "array", "items": {"type": "string"}},
              "source_kind": {"enum": ["spec-present", "spec-absent", "review-guidance", "corpus-pattern"]}
            }
          }
        },
        "element_checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "check_id",
              "model_element_id",
              "model_element_type",
              "checklist_item_id",
              "relevance",
              "presence",
              "evidence_status",
              "evidence",
              "answer",
              "answer_status",
              "derived_threat_ids"
            ],
            "properties": {
              "check_id": {"type": "string", "minLength": 1},
              "model_element_id": {"type": "string", "minLength": 1},
              "model_element_type": {"type": "string", "minLength": 1},
              "checklist_item_id": {"type": "string", "minLength": 1},
              "relevance": {"enum": ["relevant", "not_relevant", "unclear"]},
              "presence": {"enum": ["present", "partial", "absent", "unknown", "not_applicable", "not_checked"]},
              "evidence_status": {"enum": ["supplied", "verified", "inferred", "assumed", "untested", "unavailable"]},
              "evidence": {"type": "array"},
              "answer": {"type": "string", "minLength": 1},
              "answer_status": {
                "enum": ["generated_threat", "no_applicable_threat", "model_gap", "blocked", "deferred"]
              },
              "implied_concern": {"type": "string"},
              "assumptions": {"type": "array"},
              "derived_threat_ids": {"type": "array", "items": {"type": "string"}},
              "derived_trace_ids": {"type": "array", "items": {"type": "string"}},
              "remaining_question": {"type": "string"},
              "notes": {"type": "string"}
            }
          }
        }
      }
    },
    "workshop_simulation": {
      "type": "object",
      "required": ["mode", "deck", "facilitation", "card_plays"],
      "properties": {
        "mode": {"const": "card_workshop"},
        "deck": {
          "type": "object",
          "required": ["deck_id", "title", "generation_mode", "play_mode", "suits", "cards_used"],
          "properties": {
            "deck_id": {"type": "string", "minLength": 1},
            "title": {"type": "string", "minLength": 1},
            "generation_mode": {"type": "string", "minLength": 1},
            "play_mode": {"type": "string", "minLength": 1},
            "source_summary": {"type": "array"},
            "suits": {"type": "array"},
            "cards_used": {"type": "array"}
          }
        },
        "facilitation": {
          "type": "object",
          "required": ["coverage_strategy", "element_order"],
          "properties": {
            "coverage_strategy": {"type": "string", "minLength": 1},
            "element_order": {"type": "array", "items": {"type": "string"}},
            "stopping_condition": {"type": "string"}
          }
        },
        "card_plays": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "play_id",
              "card_id",
              "card_title",
              "suit",
              "prompt",
              "target_model_element_ids",
              "answer",
              "answer_status",
              "derived_threat_ids"
            ],
            "properties": {
              "play_id": {"type": "string", "minLength": 1},
              "card_id": {"type": "string", "minLength": 1},
              "card_title": {"type": "string", "minLength": 1},
              "suit": {"type": "string", "minLength": 1},
              "prompt": {"type": "string", "minLength": 1},
              "target_model_element_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
              "answer": {"type": "string", "minLength": 1},
              "answer_status": {
                "enum": ["generated_threat", "no_applicable_threat", "model_gap", "blocked", "deferred"]
              },
              "derived_threat_ids": {"type": "array", "items": {"type": "string"}},
              "derived_trace_ids": {"type": "array", "items": {"type": "string"}},
              "assumptions": {"type": "array"},
              "notes": {"type": "string"}
            }
          }
        }
      }
    },
    "principles_assessment": {
      "type": "object",
      "required": ["mode", "principle_sources", "principles", "principle_checks"],
      "properties": {
        "mode": {"const": "principles_assessment"},
        "principle_sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source_id", "title", "url"],
            "properties": {
              "source_id": {"type": "string", "minLength": 1},
              "title": {"type": "string", "minLength": 1},
              "url": {"type": "string", "minLength": 1},
              "version": {"type": "string"}
            }
          }
        },
        "principles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["principle_id", "source_id", "title", "prompt", "applies_to"],
            "properties": {
              "principle_id": {"type": "string", "minLength": 1},
              "source_id": {"type": "string", "minLength": 1},
              "title": {"type": "string", "minLength": 1},
              "prompt": {"type": "string", "minLength": 1},
              "applies_to": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "principle_checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "check_id",
              "model_element_id",
              "model_element_type",
              "principle_id",
              "relevance",
              "assessment",
              "evidence_status",
              "evidence",
              "answer",
              "answer_status",
              "derived_threat_ids"
            ],
            "properties": {
              "check_id": {"type": "string", "minLength": 1},
              "model_element_id": {"type": "string", "minLength": 1},
              "model_element_type": {"type": "string", "minLength": 1},
              "principle_id": {"type": "string", "minLength": 1},
              "relevance": {"enum": ["relevant", "not_relevant", "unclear"]},
              "assessment": {"enum": ["supported", "partially_supported", "not_supported", "conflicts", "unknown", "not_applicable", "not_checked"]},
              "evidence_status": {"enum": ["supplied", "verified", "inferred", "assumed", "untested", "unavailable"]},
              "evidence": {"type": "array"},
              "answer": {"type": "string", "minLength": 1},
              "answer_status": {
                "enum": ["generated_threat", "no_applicable_threat", "model_gap", "blocked", "deferred"]
              },
              "implied_concern": {"type": "string"},
              "assumptions": {"type": "array"},
              "derived_threat_ids": {"type": "array", "items": {"type": "string"}},
              "derived_trace_ids": {"type": "array", "items": {"type": "string"}},
              "remaining_question": {"type": "string"},
              "notes": {"type": "string"}
            }
          }
        }
      }
    },
    "design_principles_assessment": {
      "type": "object",
      "required": ["mode", "principle_sources", "principles", "principle_checks"],
      "properties": {
        "mode": {"const": "design_principles_assessment"},
        "principle_sources": {"type": "array"},
        "principles": {"type": "array"},
        "principle_checks": {"type": "array"}
      }
    },
    "privacy_principles_assessment": {
      "type": "object",
      "required": ["mode", "principle_sources", "principles", "principle_checks"],
      "properties": {
        "mode": {"const": "privacy_principles_assessment"},
        "principle_sources": {"type": "array"},
        "principles": {"type": "array"},
        "principle_checks": {"type": "array"}
      }
    },
    "method_statistics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["method", "questions_or_cards_played", "producing_answers", "non_producing_answers", "raw_candidates", "unique_threat_ids"],
        "properties": {
          "method": {"type": "string", "minLength": 1},
          "method_group": {"type": "string"},
          "compatible_model_elements": {"type": "array", "items": {"type": "string"}},
          "questions_or_cards_played": {"type": "integer", "minimum": 0},
          "producing_answers": {"type": "integer", "minimum": 0},
          "non_producing_answers": {"type": "integer", "minimum": 0},
          "raw_candidates": {"type": "integer", "minimum": 0},
          "unique_threat_ids": {"type": "array", "items": {"type": "string"}},
          "duplicate_or_confirming_candidates": {"type": "integer", "minimum": 0},
          "new_unique_threat_ids_after_previous_methods": {"type": "array", "items": {"type": "string"}},
          "limitations": {"type": "string"}
        }
      }
    },
    "dfd_element_coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["model_element_id", "model_element_type", "methods_applied", "questions_or_cards_played", "unique_threat_ids"],
        "properties": {
          "model_element_id": {"type": "string", "minLength": 1},
          "model_element_type": {"type": "string", "minLength": 1},
          "methods_applied": {"type": "array", "items": {"type": "string"}},
          "questions_or_cards_played": {"type": "integer", "minimum": 0},
          "producing_answers": {"type": "integer", "minimum": 0},
          "non_producing_answers": {"type": "integer", "minimum": 0},
          "raw_candidates": {"type": "integer", "minimum": 0},
          "unique_threat_ids": {"type": "array", "items": {"type": "string"}},
          "blocked_or_deferred_rows": {"type": "integer", "minimum": 0},
          "coverage_notes": {"type": "string"}
        }
      }
    },
    "unique_threat_inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["unique_threat_id", "title", "affected_model_elements", "first_found_by_method", "all_confirming_methods"],
        "properties": {
          "unique_threat_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "affected_model_elements": {"type": "array", "items": {"type": "string"}},
          "first_found_by_method": {"type": "string", "minLength": 1},
          "all_confirming_methods": {"type": "array", "items": {"type": "string"}},
          "duplicate_candidate_ids": {"type": "array", "items": {"type": "string"}},
          "evidence_status": {"enum": ["supplied", "verified", "inferred", "assumed", "untested", "unavailable"]},
          "response_status": {"type": "string"}
        }
      }
    },
    "method_comparison": {
      "type": "object",
      "required": ["mode", "methods_run", "total_unique_threats", "method_results"],
      "properties": {
        "mode": {"const": "multi_method"},
        "methods_run": {
          "type": "array",
          "items": {"enum": ["as_is_threat_model", "stride_per_element", "linddun_per_element", "rfc3552_security_per_element", "rfc6973_privacy_per_element", "rfc9620_human_rights_per_element", "browser_fingerprinting_prompt_lens", "xs_leaks_oracle_checklist", "microsoft_harms_modeling_per_element", "workshop_simulation", "stride_workshop_simulation", "linddun_workshop_simulation", "checklist_assessment", "principles_assessment", "design_principles_assessment", "privacy_principles_assessment", "independent_additional_elicitation"]}
        },
        "total_unique_threats": {"type": "integer", "minimum": 0},
        "method_results": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["method", "threats_found", "unique_threat_ids", "overlapping_threat_ids"],
            "properties": {
              "method": {"enum": ["as_is_threat_model", "stride_per_element", "linddun_per_element", "rfc3552_security_per_element", "rfc6973_privacy_per_element", "rfc9620_human_rights_per_element", "browser_fingerprinting_prompt_lens", "xs_leaks_oracle_checklist", "microsoft_harms_modeling_per_element", "workshop_simulation", "stride_workshop_simulation", "linddun_workshop_simulation", "checklist_assessment", "principles_assessment", "design_principles_assessment", "privacy_principles_assessment", "independent_additional_elicitation"]},
              "threats_found": {"type": "integer", "minimum": 0},
              "unique_threat_ids": {"type": "array", "items": {"type": "string"}},
              "overlapping_threat_ids": {"type": "array", "items": {"type": "string"}},
              "model_gaps_found": {"type": "integer", "minimum": 0},
              "qualitative_notes": {"type": "string"},
              "limitations": {"type": "string"}
            }
          }
        },
        "overlaps": {"type": "array"},
        "recommended_followup_method": {"type": "string"},
        "recommendation_basis": {"type": "string"}
      }
    },
    "independent_elicitation_pass": {
      "type": "object",
      "required": ["mode", "baseline_threat_package_id", "methods_run", "candidate_checks", "reconciliation_summary"],
      "properties": {
        "mode": {"const": "independent_additional_elicitation"},
        "baseline_threat_package_id": {"type": "string", "minLength": 1},
        "goal": {"type": "string"},
        "methods_run": {
          "type": "array",

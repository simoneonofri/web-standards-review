{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/threat-model-contract-v1/model-packet.schema.json",
  "title": "Threat Model Model Packet v1",
  "type": "object",
  "required": [
    "contract_version",
    "model_id",
    "system_under_analysis",
    "scenario",
    "dfd_detail_level",
    "abstraction_level",
    "scope",
    "out_of_scope",
    "source_inventory",
    "external_entities",
    "processes",
    "data_stores",
    "data_flows",
    "trust_boundaries",
    "assumptions",
    "inline_safeguards",
    "implicit_threat_model_signals",
    "review_signals",
    "unresolved_questions",
    "validation_notes"
  ],
  "properties": {
    "contract_version": {"const": 1},
    "model_id": {"type": "string", "minLength": 1},
    "system_under_analysis": {"type": "string", "minLength": 1},
    "scenario": {"type": "string"},
    "dfd_detail_level": {"enum": ["high-level", "medium-detail", "very-detailed"]},
    "abstraction_level": {"type": "string"},
    "scope": {"type": "array"},
    "out_of_scope": {"type": "array"},
    "source_inventory": {"type": "array"},
    "external_entities": {"type": "array", "items": {"$ref": "#/$defs/dfd_element"}},
    "processes": {"type": "array", "items": {"$ref": "#/$defs/dfd_element"}},
    "data_stores": {"type": "array", "items": {"$ref": "#/$defs/dfd_element"}},
    "data_flows": {"type": "array", "items": {"$ref": "#/$defs/data_flow"}},
    "trust_boundaries": {"type": "array", "items": {"$ref": "#/$defs/trust_boundary"}},
    "assumptions": {"type": "array"},
    "inline_safeguards": {"type": "array"},
    "implicit_threat_model_signals": {"type": "array"},
    "review_signals": {"type": "array"},
    "unresolved_questions": {"type": "array"},
    "validation_notes": {"type": "array"}
  },
  "$defs": {
    "dfd_element": {
      "type": "object",
      "required": ["type", "name", "description", "evidence_status", "source_reference", "confidence", "notes"],
      "anyOf": [
        {"required": ["stable_id"]},
        {"required": ["candidate_id"]}
      ],
      "properties": {
        "stable_id": {"type": "string", "pattern": "^(EE|PO|DS|DF|TB)-[0-9]{2,}$"},
        "candidate_id": {"type": "string"},
        "type": {"enum": ["External Entity", "Process", "Data Store", "Data Flow", "Trust Boundary"]},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "evidence_status": {"enum": ["supplied", "verified", "inferred", "assumed", "untested", "unavailable"]},
        "source_reference": {"type": "string", "minLength": 1},
        "source_quote": {"type": "string"},
        "source_locator": {"type": "string"},
        "normative_status": {"type": "string"},
        "confidence": {"enum": ["low", "medium", "high"]},
        "notes": {"type": "string"},
        "source": {"type": "string", "pattern": "^(EE|PO|DS|DF|TB)-[0-9]{2,}$"},
        "destination": {"type": "string", "pattern": "^(EE|PO|DS|DF|TB)-[0-9]{2,}$"},
        "target": {"type": "string", "pattern": "^(EE|PO|DS|DF|TB)-[0-9]{2,}$"},
        "flow_source": {"type": "string", "pattern": "^(EE|PO|DS|DF|TB)-[0-9]{2,}$"},
        "flow_destination": {"type": "string", "pattern": "^(EE|PO|DS|DF|TB)-[0-9]{2,}$"}
      }
    },
    "trust_boundary": {
      "allOf": [
        {"$ref": "#/$defs/dfd_element"},
        {
          "type": "object",
          "required": ["justification"],
          "properties": {
            "justification": {"type": "string", "minLength": 1},
            "boundary_basis": {
              "type": "array",
              "items": {"enum": ["authority", "control", "privilege", "responsibility", "origin", "administrative_domain", "user_agency", "data_protection_context"]}
            }
          }
        }
      ]
    },
    "data_flow": {
      "allOf": [
        {"$ref": "#/$defs/dfd_element"},
        {
          "type": "object",
          "anyOf": [
            {"required": ["source", "destination"]},
            {"required": ["source", "target"]},
            {"required": ["flow_source", "flow_destination"]}
          ]
        }
      ]
    }
  }
}
